+
+struct RK3326State {
+    SysBusDevice parent_obj;
+
+    ARMCPU cpus[RK3326_NUM_CPUS];
+    GICState gic;
+
+    RockchipGRFState grf;
+    RockchipGRFState pmugrf;
+    RockchipGRFState core_grf;
+    RockchipGRFState cpu_boost;
+    RockchipGRFState usb2phy_grf;
+    RockchipGRFState video_phy;
