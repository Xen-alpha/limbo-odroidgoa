diff --git a/hw/misc/rk3326_cru.c b/hw/misc/rk3326_cru.c
new file mode 100644
index 00000000..9edc8005
--- /dev/null
+++ b/hw/misc/rk3326_cru.c
@@ -0,0 +1,221 @@
+/*
+ * Rockchip RK3326/PX30 Clock and Reset Unit (CRU and PMUCRU)
+ *
+ * Register layout follows the PX30 CRU as used by the Hardkernel
+ * u-boot (arch/arm/include/asm/arch-rockchip/cru_px30.h) and Linux
+ * (drivers/clk/rockchip/clk-px30.c) for the ODROID-GO Advance.
+ *
+ * Clocks are not modelled: the CRU is a register file with the PX30
+ * HIWORD write-mask semantics, PLL lock reporting and the global
+ * software reset registers.
+ *
+ * Reset values describe the state left behind by the Rockchip DDR init
+ * blob + miniloader (which the QEMU board replaces): all PLLs locked in
+ * normal mode, APLL 600 MHz, DPLL 666 MHz (DDR 333 MHz), CPLL 1200 MHz,
+ * NPLL 1188 MHz, GPLL 1200 MHz.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/rk3326_cru.h"
+#include "migration/vmstate.h"
+#include "sysemu/runstate.h"
+
+/* CRU */
+#define CRU_PLL_CON(pll, n)     ((pll) * 0x20 + (n) * 4)
+#define CRU_MODE_CON            0xa0
+#define CRU_MISC_CON            0xa4
+#define CRU_GLB_CNT_TH          0xb0
+#define CRU_GLB_RST_ST          0xb4
+#define CRU_GLB_SRST_FST        0xb8
+#define CRU_GLB_SRST_SND        0xbc
+#define CRU_GLB_RST_CON         0xc0
+#define CRU_SSGTBL_START        0x280
+#define CRU_SSGTBL_END          0x300
+
+/* PMUCRU */
+#define PMUCRU_MODE             0x20
+
+#define PLL_CON1_LOCK           (1u << 10)
+#define PLL_CON1_PWRDOWN        (1u << 13)
+
+#define GLB_SRST_FST_VAL        0xfdb9
+#define GLB_SRST_SND_VAL        0xeca8
+
+static bool rk_cru_is_pll_reg(RK3326CRUState *s, hwaddr off, int *n)
+{
+    hwaddr end = s->pmucru ? 0x20 : 0x80;
+
+    if (off >= end) {
+        return false;
+    }
+    *n = (off & 0x1f) >> 2;
+    return *n <= 4;
+}
+
+static bool rk_cru_is_plain(RK3326CRUState *s, hwaddr off)
+{
+    int n;
+
+    if (rk_cru_is_pll_reg(s, off, &n)) {
+        return n == 2;          /* CON2: 24-bit fractional divider */
+    }
+    if (s->pmucru) {
+        return false;
+    }
+    switch (off) {
+    case CRU_GLB_CNT_TH:
+    case CRU_GLB_RST_CON:
+        return true;
+    }
+    return off >= CRU_SSGTBL_START && off < CRU_SSGTBL_END;
+}
+
+static uint64_t rk_cru_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RK3326CRUState *s = opaque;
+    uint32_t val = s->regs[offset >> 2];
+    int n;
+
+    if (rk_cru_is_pll_reg(s, offset, &n) && n == 1) {
+        /* PLLs lock instantly once powered up */
+        val &= ~PLL_CON1_LOCK;
+        if (!(val & PLL_CON1_PWRDOWN)) {
+            val |= PLL_CON1_LOCK;
+        }
+    }
+    if (!s->pmucru && offset == CRU_GLB_RST_ST) {
+        val = s->glb_rst_st;
+    }
+    return val;
+}
+
+static void rk_cru_write(void *opaque, hwaddr offset, uint64_t value,
+                         unsigned size)
+{
+    RK3326CRUState *s = opaque;
+    unsigned idx = offset >> 2;
+    uint32_t mask;
+
+    if (!s->pmucru) {
+        switch (offset) {
+        case CRU_GLB_RST_ST:
+            /* write 1 to clear */
+            s->glb_rst_st &= ~value;
+            return;
+        case CRU_GLB_SRST_FST:
+        case CRU_GLB_SRST_SND:
+            s->regs[idx] = value;
+            if ((offset == CRU_GLB_SRST_FST && value == GLB_SRST_FST_VAL) ||
+                (offset == CRU_GLB_SRST_SND && value == GLB_SRST_SND_VAL)) {
+                s->glb_rst_st = (offset == CRU_GLB_SRST_FST) ? 1 : 2;
+                qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+            }
+            return;
+        }
+    }
+
+    if (rk_cru_is_plain(s, offset)) {
+        s->regs[idx] = value;
+        return;
+    }
+    mask = (value >> 16) & 0xffff;
+    s->regs[idx] = (s->regs[idx] & ~mask) | (value & mask);
+}
+
+static const MemoryRegionOps rk_cru_ops = {
+    .read = rk_cru_read,
+    .write = rk_cru_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/*
+ * PLL register encoding (rk3036/rk3328 style integer PLL):
+ *  CON0: [15] bypass, [14:12] postdiv1, [11:0] fbdiv
+ *  CON1: [13] pwrdown, [12] dsmpd, [10] lock, [8:6] postdiv2, [5:0] refdiv
+ */
+#define PLL_CON0(fb, pd1)       (((pd1) << 12) | (fb))
+#define PLL_CON1(ref, pd2)      ((1u << 12) | ((pd2) << 6) | (ref))
+
+static void rk_cru_set_pll(RK3326CRUState *s, int pll, uint32_t fb,
+                           uint32_t ref, uint32_t pd1, uint32_t pd2)
+{
+    s->regs[CRU_PLL_CON(pll, 0) >> 2] = PLL_CON0(fb, pd1);
+    s->regs[CRU_PLL_CON(pll, 1) >> 2] = PLL_CON1(ref, pd2);
+    s->regs[CRU_PLL_CON(pll, 2) >> 2] = 0;
+}
+
+static void rk_cru_reset_hold(Object *obj)
+{
+    RK3326CRUState *s = RK3326_CRU(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    if (s->pmucru) {
+        rk_cru_set_pll(s, 0, 100, 2, 1, 1);         /* GPLL 1200 MHz */
+        s->regs[PMUCRU_MODE >> 2] = 0x1;            /* GPLL normal */
+    } else {
+        rk_cru_set_pll(s, 0, 75, 1, 3, 1);          /* APLL 600 MHz */
+        rk_cru_set_pll(s, 1, 111, 1, 4, 1);         /* DPLL 666 MHz */
+        rk_cru_set_pll(s, 2, 100, 2, 1, 1);         /* CPLL 1200 MHz */
+        rk_cru_set_pll(s, 3, 99, 2, 1, 1);          /* NPLL 1188 MHz */
+        /* MODE_CON: apll[1:0] cpll[3:2] dpll[5:4] npll[7:6], 1 = normal */
+        s->regs[CRU_MODE_CON >> 2] = 0x55;
+        s->regs[CRU_GLB_CNT_TH >> 2] = 0x3a980064;
+    }
+}
+
+static void rk_cru_init(Object *obj)
+{
+    RK3326CRUState *s = RK3326_CRU(obj);
+
+    memory_region_init_io(&s->iomem, obj, &rk_cru_ops, s, TYPE_RK3326_CRU,
+                          RK3326_CRU_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static Property rk_cru_props[] = {
+    DEFINE_PROP_BOOL("pmucru", RK3326CRUState, pmucru, false),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static const VMStateDescription vmstate_rk_cru = {
+    .name = TYPE_RK3326_CRU,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, RK3326CRUState, RK3326_CRU_NREGS),
+        VMSTATE_UINT32(glb_rst_st, RK3326CRUState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_cru_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &vmstate_rk_cru;
+    device_class_set_props(dc, rk_cru_props);
+    rc->phases.hold = rk_cru_reset_hold;
+}
+
+static const TypeInfo rk_cru_info = {
+    .name = TYPE_RK3326_CRU,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RK3326CRUState),
+    .instance_init = rk_cru_init,
+    .class_init = rk_cru_class_init,
+};
+
+static void rk_cru_register_types(void)
+{
+    type_register_static(&rk_cru_info);
+}
+
+type_init(rk_cru_register_types)
diff --git a/hw/misc/rk3326_pmu.c b/hw/misc/rk3326_pmu.c
new file mode 100644
index 00000000..70908461
--- /dev/null
+++ b/hw/misc/rk3326_pmu.c
@@ -0,0 +1,139 @@
+/*
+ * Rockchip RK3326/PX30 Power Management Unit
+ *
+ * Models the power domain and NIU (bus idle) handshake registers used by
+ * drivers/soc/rockchip/pm_domains.c (px30_pmu):
+ *
+ *   0x18 PMU_PWRDN_CON   hiword, bit n = power domain n off request
+ *   0x20 PMU_PWRDN_ST    read-only, bit n = power domain n is off
+ *   0x64 PMU_BUS_IDLE_REQ hiword, bit n = idle request for NIU n
+ *   0x6c PMU_BUS_IDLE_ST read-only, [15:0] ack, [31:16] idle
+ *
+ * Power domains switch instantly.  Everything else is plain storage;
+ * system suspend (handled by EL3 firmware on real hardware) is not
+ * modelled.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/misc/rk3326_pmu.h"
+#include "migration/vmstate.h"
+
+#define PMU_WAKEUP_CFG0         0x00
+#define PMU_PWRDN_CON           0x18
+#define PMU_PWRDN_ST            0x20
+#define PMU_PWRMODE_CORE_CON    0x24
+#define PMU_PWRMODE_COMMON_CON  0x28
+#define PMU_BUS_IDLE_REQ        0x64
+#define PMU_BUS_IDLE_ST         0x6c
+
+static bool rk_pmu_is_hiword(hwaddr offset)
+{
+    switch (offset) {
+    case PMU_PWRDN_CON:
+    case PMU_BUS_IDLE_REQ:
+    case PMU_PWRMODE_CORE_CON:
+    case PMU_PWRMODE_COMMON_CON:
+        return true;
+    }
+    return false;
+}
+
+static uint64_t rk_pmu_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RK3326PMUState *s = opaque;
+    uint32_t req;
+
+    switch (offset) {
+    case PMU_PWRDN_ST:
+        return s->regs[PMU_PWRDN_CON >> 2] & 0xffff;
+    case PMU_BUS_IDLE_ST:
+        req = s->regs[PMU_BUS_IDLE_REQ >> 2] & 0xffff;
+        return req | (req << 16);
+    }
+    return s->regs[offset >> 2];
+}
+
+static void rk_pmu_write(void *opaque, hwaddr offset, uint64_t value,
+                         unsigned size)
+{
+    RK3326PMUState *s = opaque;
+    unsigned idx = offset >> 2;
+    uint32_t mask;
+
+    switch (offset) {
+    case PMU_PWRDN_ST:
+    case PMU_BUS_IDLE_ST:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "rk3326-pmu: write to read-only reg 0x%" HWADDR_PRIx
+                      "\n", offset);
+        return;
+    }
+    if (rk_pmu_is_hiword(offset)) {
+        mask = (value >> 16) & 0xffff;
+        s->regs[idx] = (s->regs[idx] & ~mask) | (value & mask);
+    } else {
+        s->regs[idx] = value;
+    }
+}
+
+static const MemoryRegionOps rk_pmu_ops = {
+    .read = rk_pmu_read,
+    .write = rk_pmu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void rk_pmu_reset_hold(Object *obj)
+{
+    RK3326PMUState *s = RK3326_PMU(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void rk_pmu_init(Object *obj)
+{
+    RK3326PMUState *s = RK3326_PMU(obj);
+
+    memory_region_init_io(&s->iomem, obj, &rk_pmu_ops, s, TYPE_RK3326_PMU,
+                          RK3326_PMU_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static const VMStateDescription vmstate_rk_pmu = {
+    .name = TYPE_RK3326_PMU,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, RK3326PMUState, RK3326_PMU_NREGS),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_pmu_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &vmstate_rk_pmu;
+    rc->phases.hold = rk_pmu_reset_hold;
+}
+
+static const TypeInfo rk_pmu_info = {
+    .name = TYPE_RK3326_PMU,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RK3326PMUState),
+    .instance_init = rk_pmu_init,
+    .class_init = rk_pmu_class_init,
+};
+
+static void rk_pmu_register_types(void)
+{
+    type_register_static(&rk_pmu_info);
+}
+
+type_init(rk_pmu_register_types)
diff --git a/hw/misc/rk817.c b/hw/misc/rk817.c
new file mode 100644
index 00000000..0b1c41c1
--- /dev/null
+++ b/hw/misc/rk817.c
@@ -0,0 +1,751 @@
+/*
+ * Rockchip RK817 PMIC I2C model
+ *
+ * Register map from include/linux/mfd/rk808.h, drivers/mfd/rk808.c,
+ * drivers/rtc/rtc-rk808.c, drivers/power/rk817_battery.c and
+ * drivers/power/rk817_charger.c of the Hardkernel odroidgoA-4.4.y
+ * kernel and drivers/power/{pmic/rk8xx.c,fuel_gauge/fg_rk817.c} of
+ * the Hardkernel odroidgoa-v2017.09 u-boot.
+ *
+ * Modelled:
+ *  - I2C register file with auto-incrementing register pointer
+ *  - chip id (0x8170), on/off source
+ *  - POWER_EN registers with nibble write-enable mask
+ *  - RTC: BCD time keeping with the RK808-family calendar in which
+ *    November has 31 days (the Linux driver compensates for it),
+ *    STOP/GET_TIME/READSEL handling and the alarm interrupt
+ *  - interrupt status/mask registers and the INT pin (polarity from
+ *    GPIO_INT_CFG), power key press/release interrupts
+ *  - SYS_CFG3 DEV_OFF and the SLEEP pin power-down/reset functions
+ *  - fuel gauge ADC results (battery/system/USB voltage, battery
+ *    current) in the units implied by the VCALIB0/1 calibration
+ *    registers, the coulomb counter (Q_INIT/Q_PRESS) and the charger
+ *    status registers
+ * Codec, clock outputs and regulator voltages are plain registers.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bcd.h"
+#include "qemu/cutils.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/rk817.h"
+#include "migration/vmstate.h"
+#include "qemu-common.h"
+#include "sysemu/sysemu.h"
+#include "sysemu/runstate.h"
+
+/* RTC */
+#define RTC_SECONDS         0x00
+#define RTC_WEEKS           0x06
+#define RTC_ALARM_SECONDS   0x07
+#define RTC_ALARM_YEARS     0x0c
+#define RTC_CTRL            0x0d
+#define RTC_STATUS          0x0e
+#define RTC_INT             0x0f
+
+#define RTC_CTRL_STOP       (1u << 0)
+#define RTC_CTRL_GET_TIME   (1u << 6)
+#define RTC_CTRL_READSEL    (1u << 7)
+#define RTC_STATUS_ALARM    (1u << 6)
+#define RTC_STATUS_POWER_UP (1u << 7)
+#define RTC_INT_ALARM_EN    (1u << 3)
+
+/* fuel gauge */
+#define FG_ADC_CONFIG0      0x50
+#define FG_GG_STS           0x57
+#define FG_GG_STS_BAT_CON   (1u << 4)
+#define FG_RELAX_VOL1_H     0x5a
+#define FG_RELAX_VOL2_H     0x5c
+#define FG_RELAX_CUR1_H     0x5e
+#define FG_RELAX_CUR2_H     0x60
+#define FG_OCV_VOL_H        0x63
+#define FG_OCV_VOL0_H       0x65
+#define FG_OCV_CUR_H        0x67
+#define FG_OCV_CUR0_H       0x69
+#define FG_PWRON_VOL_H      0x6b
+#define FG_PWRON_CUR_H      0x6d
+#define FG_Q_INIT_H3        0x70
+#define FG_Q_INIT_L0        0x73
+#define FG_Q_PRESS_H3       0x74
+#define FG_Q_PRESS_L0       0x77
+#define FG_BAT_VOL_H        0x78
+#define FG_BAT_CUR_H        0x7a
+#define FG_BAT_TS_H         0x7c
+#define FG_USB_VOL_H        0x7e
+#define FG_SYS_VOL_H        0x80
+#define FG_VCALIB0_H        0x93
+#define FG_VCALIB1_H        0x95
+#define FG_LAST             0xb0
+
+/* power */
+#define POWER_EN_REG0       0xb1
+#define POWER_EN_REG3       0xb4
+#define BUCK1_ON_VSEL       0xbb
+#define BUCK2_ON_VSEL       0xbe
+#define BUCK3_ON_VSEL       0xc1
+#define BUCK4_ON_VSEL       0xc4
+#define LDO_ON_VSEL(i)      (0xcc + (i) * 2)
+
+#define CHRG_STS            0xeb
+#define ID_MSB              0xed
+#define ID_LSB              0xee
+#define SYS_STS             0xf0
+#define SYS_STS_PLUG_IN     (1u << 6)
+#define SYS_CFG3            0xf4
+#define SYS_CFG3_DEV_OFF    (1u << 0)
+#define SYS_CFG3_SLPPIN_SHIFT 3
+#define SYS_CFG3_SLPPOL_H   (1u << 5)
+#define ON_SOURCE           0xf5
+#define OFF_SOURCE          0xf6
+#define INT_STS0            0xf8
+#define INT_MSK0            0xf9
+#define INT_STS1            0xfa
+#define INT_MSK1            0xfb
+#define INT_STS2            0xfc
+#define INT_MSK2            0xfd
+#define GPIO_INT_CFG        0xfe
+#define GPIO_INT_POL_H      (1u << 1)
+
+#define IRQ0_PWRON_FALL     (1u << 0)
+#define IRQ0_PWRON_RISE     (1u << 1)
+#define IRQ0_RTC_ALARM      (1u << 5)
+#define IRQ1_PLUG_IN        (1u << 0)
+#define IRQ1_PLUG_OUT       (1u << 1)
+
+#define CHRG_STS_BAT_EXS    (1u << 7)
+#define CHG_STS_CC_OR_CV    3
+
+/*
+ * ADC scaling.  The voltage ADC is calibrated by VCALIB0 (2300 mV) and
+ * VCALIB1 (4025 mV); we pick 4 codes per mV.  Currents use the
+ * 172 uA/LSB (at 10 mOhm sense resistor) scale of the driver.
+ */
+#define VCALIB0_CODE        (2300 * 4)
+#define VCALIB1_CODE        (4025 * 4)
+
+/* --- RTC calendar -------------------------------------------------- */
+
+static int rk817_days_in_month(int mon, int year)
+{
+    static const int days[12] = {31, 28, 31, 30, 31, 30,
+                                 31, 31, 30, 31, 31 /* Nov! */, 31};
+    bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+
+    if (mon == 2 && leap) {
+        return 29;
+    }
+    return days[mon - 1];
+}
+
+static void rk817_date_add(RK817Date *d, int64_t secs)
+{
+    int64_t days;
+    int64_t tod = d->hour * 3600 + d->min * 60 + d->sec + secs;
+
+    days = tod / 86400;
+    tod %= 86400;
+    if (tod < 0) {
+        tod += 86400;
+        days--;
+    }
+    d->hour = tod / 3600;
+    d->min = (tod / 60) % 60;
+    d->sec = tod % 60;
+    d->wday = (int)(((d->wday + days) % 7 + 7) % 7);
+    while (days > 0) {
+        int dim = rk817_days_in_month(d->mon, d->year);
+        int left = dim - d->mday + 1;
+
+        if (days < left) {
+            d->mday += days;
+            break;
+        }
+        days -= left;
+        d->mday = 1;
+        if (++d->mon > 12) {
+            d->mon = 1;
+            d->year++;
+        }
+    }
+}
+
+static void rk817_rtc_now(RK817State *s, RK817Date *d)
+{
+    *d = s->rtc_base;
+    if (!s->rtc_stopped) {
+        int64_t now = qemu_clock_get_ns(rtc_clock);
+
+        rk817_date_add(d, (now - s->rtc_base_ns) / NANOSECONDS_PER_SECOND);
+    }
+}
+
+static void rk817_rtc_rebase(RK817State *s)
+{
+    int64_t now = qemu_clock_get_ns(rtc_clock);
+    int64_t secs;
+
+    if (!s->rtc_stopped) {
+        secs = (now - s->rtc_base_ns) / NANOSECONDS_PER_SECOND;
+        rk817_date_add(&s->rtc_base, secs);
+        s->rtc_base_ns += secs * NANOSECONDS_PER_SECOND;
+    }
+}
+
+static void rk817_rtc_init_time(RK817State *s)
+{
+    struct tm tm;
+    struct tm ref = { .tm_year = 116, .tm_mon = 0, .tm_mday = 1 };
+    int64_t host, ref_secs;
+
+    qemu_get_timedate(&tm, 0);
+    host = mktimegm(&tm);
+    ref_secs = mktimegm(&ref);
+
+    /* the RTC is assumed to have been set by an OS at 2016-01-01 */
+    s->rtc_base = (RK817Date) {
+        .sec = 0, .min = 0, .hour = 0, .mday = 1, .mon = 1, .year = 2016,
+        .wday = 5,      /* Friday */
+    };
+    if (host > ref_secs) {
+        rk817_date_add(&s->rtc_base, host - ref_secs);
+    }
+    s->rtc_base_ns = qemu_clock_get_ns(rtc_clock);
+    s->rtc_stopped = false;
+}
+
+static uint8_t rk817_rtc_field(const RK817Date *d, int reg)
+{
+    switch (reg) {
+    case 0:
+        return to_bcd(d->sec);
+    case 1:
+        return to_bcd(d->min);
+    case 2:
+        return to_bcd(d->hour);
+    case 3:
+        return to_bcd(d->mday);
+    case 4:
+        return to_bcd(d->mon);
+    case 5:
+        return to_bcd(d->year % 100);
+    case 6:
+        return to_bcd(d->wday);
+    }
+    return 0;
+}
+
+static void rk817_rtc_set_field(RK817Date *d, int reg, uint8_t v)
+{
+    int val = from_bcd(v);
+
+    switch (reg) {
+    case 0:
+        d->sec = MIN(val, 59);
+        break;
+    case 1:
+        d->min = MIN(val, 59);
+        break;
+    case 2:
+        d->hour = MIN(from_bcd(v & 0x3f), 23);
+        break;
+    case 3:
+        d->mday = MAX(MIN(val, 31), 1);
+        break;
+    case 4:
+        d->mon = MAX(MIN(val, 12), 1);
+        break;
+    case 5:
+        d->year = 2000 + val;
+        break;
+    case 6:
+        d->wday = val % 7;
+        break;
+    }
+}
+
+/* --- interrupts ------------------------------------------------------ */
+
+static void rk817_update_irq(RK817State *s)
+{
+    bool active = (s->regs[INT_STS0] & ~s->regs[INT_MSK0]) ||
+                  (s->regs[INT_STS1] & ~s->regs[INT_MSK1]) ||
+                  (s->regs[INT_STS2] & ~s->regs[INT_MSK2]);
+    bool pol_high = s->regs[GPIO_INT_CFG] & GPIO_INT_POL_H;
+    bool level = pol_high ? active : !active;
+
+    s->irq_level = level;
+    qemu_set_irq(s->irq, level);
+}
+
+static void rk817_rtc_check_alarm(RK817State *s)
+{
+    RK817Date now;
+    bool match = true;
+
+    if (!(s->regs[RTC_INT] & RTC_INT_ALARM_EN)) {
+        return;
+    }
+    rk817_rtc_now(s, &now);
+    for (int i = 0; i < 6; i++) {
+        if (s->regs[RTC_ALARM_SECONDS + i] != rk817_rtc_field(&now, i)) {
+            match = false;
+            break;
+        }
+    }
+    if (match) {
+        s->regs[RTC_STATUS] |= RTC_STATUS_ALARM;
+        s->regs[INT_STS0] |= IRQ0_RTC_ALARM;
+        rk817_update_irq(s);
+    }
+}
+
+static void rk817_rtc_tick(void *opaque)
+{
+    RK817State *s = opaque;
+
+    rk817_rtc_check_alarm(s);
+    if (s->regs[RTC_INT] & RTC_INT_ALARM_EN) {
+        timer_mod(s->rtc_timer, qemu_clock_get_ms(rtc_clock) + 500);
+    }
+}
+
+/* --- fuel gauge ------------------------------------------------------ */
+
+static void rk817_put16(RK817State *s, int reg, uint16_t v)
+{
+    s->regs[reg] = v >> 8;
+    s->regs[reg + 1] = v & 0xff;
+}
+
+static int32_t rk817_cur_to_adc(int32_t ma)
+{
+    /* ADC_TO_CURRENT(adc) = adc * 172 / 1000 (10 mOhm, res_div 1) */
+    return (int32_t)((int64_t)ma * 1000 / 172);
+}
+
+static void rk817_fg_update_q(RK817State *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t elapsed = now - s->q_last_ns;
+    int64_t secs = elapsed / NANOSECONDS_PER_SECOND;
+
+    if (secs > 0) {
+        s->q_press += (int64_t)rk817_cur_to_adc(s->bat_ma) * secs;
+        if (s->q_press < 0) {
+            s->q_press = 0;
+        }
+        if (s->q_press > 0x7fffffff) {
+            s->q_press = 0x7fffffff;
+        }
+        s->q_last_ns += secs * NANOSECONDS_PER_SECOND;
+    }
+}
+
+static void rk817_fg_refresh(RK817State *s)
+{
+    uint32_t sys_mv = s->dc_in ? 5000 : s->bat_mv;
+    uint16_t vcode = s->battery_present ? s->bat_mv * 4 : 0;
+    uint16_t ccode = (uint16_t)rk817_cur_to_adc(s->bat_ma);
+
+    rk817_put16(s, FG_BAT_VOL_H, vcode);
+    rk817_put16(s, FG_BAT_CUR_H, ccode);
+    rk817_put16(s, FG_SYS_VOL_H, sys_mv * 4 * 46 / 60);
+    rk817_put16(s, FG_USB_VOL_H, s->dc_in ? s->usb_mv * 4 * 46 / 60 : 0);
+    rk817_put16(s, FG_BAT_TS_H, 0);
+
+    s->regs[CHRG_STS] = (s->regs[CHRG_STS] & 0x0f) |
+                        (s->battery_present ? CHRG_STS_BAT_EXS : 0) |
+                        ((s->dc_in ? CHG_STS_CC_OR_CV : 0) << 4);
+    if (s->dc_in) {
+        s->regs[SYS_STS] |= SYS_STS_PLUG_IN;
+    } else {
+        s->regs[SYS_STS] &= ~SYS_STS_PLUG_IN;
+    }
+
+    rk817_fg_update_q(s);
+    s->regs[FG_Q_PRESS_H3] = (s->q_press >> 24) | (s->q_valid ? 0 : 0x80);
+    s->regs[FG_Q_PRESS_H3 + 1] = s->q_press >> 16;
+    s->regs[FG_Q_PRESS_H3 + 2] = s->q_press >> 8;
+    s->regs[FG_Q_PRESS_L0] = s->q_press;
+}
+
+static void rk817_fg_power_on(RK817State *s)
+{
+    uint16_t vcode = s->bat_mv * 4;
+    uint16_t ccode = (uint16_t)rk817_cur_to_adc(s->bat_ma);
+
+    rk817_put16(s, FG_VCALIB0_H, VCALIB0_CODE);
+    rk817_put16(s, FG_VCALIB1_H, VCALIB1_CODE);
+    /* sampled values captured by the gauge at power on / relax */
+    rk817_put16(s, FG_PWRON_VOL_H, vcode);
+    rk817_put16(s, FG_PWRON_CUR_H, ccode);
+    rk817_put16(s, FG_OCV_VOL_H, vcode);
+    rk817_put16(s, FG_OCV_VOL0_H, vcode);
+    rk817_put16(s, FG_OCV_CUR_H, ccode);
+    rk817_put16(s, FG_OCV_CUR0_H, ccode);
+    rk817_put16(s, FG_RELAX_VOL1_H, vcode);
+    rk817_put16(s, FG_RELAX_VOL2_H, vcode);
+    rk817_put16(s, FG_RELAX_CUR1_H, ccode);
+    rk817_put16(s, FG_RELAX_CUR2_H, ccode);
+    /* battery freshly connected: invalid capacity, BAT_CON set */
+    s->regs[FG_GG_STS] = FG_GG_STS_BAT_CON;
+    s->q_press = 0;
+    s->q_valid = false;                 /* Q_PRESS_H3 reads CAP_INVALID */
+    s->q_last_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+/* --- register access ------------------------------------------------ */
+
+static void rk817_power_defaults(RK817State *s)
+{
+    /*
+     * Power-on defaults of the RK817 OTP as used on the ODROID-GO Advance:
+     * DCDC1-4 on; LDO2/3/4 (SoC 1.8V/1.0V, PMU 3.3V) on; LDO5/6 (SD) on;
+     * LDO9 (WiFi) and BOOST on.
+     */
+    s->regs[POWER_EN_REG0 + 0] = 0x0f;
+    s->regs[POWER_EN_REG0 + 1] = 0x0e;
+    s->regs[POWER_EN_REG0 + 2] = 0x03;
+    s->regs[POWER_EN_REG0 + 3] = 0x03;
+    s->regs[0xb5] = 0x0f;               /* POWER_SLP_EN */
+    s->regs[BUCK1_ON_VSEL] = 0x28;      /* 1.0 V */
+    s->regs[BUCK2_ON_VSEL] = 0x28;      /* 1.0 V */
+    s->regs[BUCK3_ON_VSEL] = 0x28;
+    s->regs[BUCK4_ON_VSEL] = 0x62;      /* 3.3 V */
+    s->regs[LDO_ON_VSEL(0)] = 0x10;     /* 1.0 V */
+    s->regs[LDO_ON_VSEL(1)] = 0x30;     /* 1.8 V */
+    s->regs[LDO_ON_VSEL(2)] = 0x10;     /* 1.0 V */
+    s->regs[LDO_ON_VSEL(3)] = 0x6c;     /* 3.3 V */
+    s->regs[LDO_ON_VSEL(4)] = 0x6c;     /* 3.3 V */
+    s->regs[LDO_ON_VSEL(5)] = 0x6c;     /* 3.3 V */
+    s->regs[LDO_ON_VSEL(6)] = 0x6c;     /* 3.3 V */
+    s->regs[LDO_ON_VSEL(7)] = 0x58;     /* 2.8 V */
+    s->regs[LDO_ON_VSEL(8)] = 0x6c;     /* 3.3 V */
+}
+
+static void rk817_regs_reset(RK817State *s, bool cold)
+{
+    uint8_t keep[256];
+
+    memcpy(keep, s->regs, sizeof(keep));
+    memset(s->regs, 0, sizeof(s->regs));
+    if (!cold) {
+        /* RTC and gauge are always powered */
+        memcpy(&s->regs[0x00], &keep[0x00], 0x12);
+        memcpy(&s->regs[FG_ADC_CONFIG0], &keep[FG_ADC_CONFIG0],
+               FG_LAST - FG_ADC_CONFIG0 + 1);
+    }
+    rk817_power_defaults(s);
+    s->regs[ID_MSB] = 0x81;
+    s->regs[ID_LSB] = 0x70;
+    s->regs[ON_SOURCE] = 0x80;          /* power on by PWRON key */
+    s->regs[OFF_SOURCE] = 0x00;
+    s->regs[INT_MSK0] = 0x00;
+    s->regs[INT_MSK1] = 0x00;
+    s->regs[INT_MSK2] = 0x00;
+    s->regs[GPIO_INT_CFG] = 0x00;       /* INT active low */
+    if (cold) {
+        s->regs[RTC_STATUS] = RTC_STATUS_POWER_UP;
+        rk817_rtc_init_time(s);
+        rk817_rtc_now(s, &s->rtc_latch);
+        rk817_fg_power_on(s);
+    }
+    s->ptr = 0;
+    s->ptr_set = false;
+}
+
+static uint8_t rk817_reg_read(RK817State *s, uint8_t reg)
+{
+    if (reg <= RTC_WEEKS) {
+        RK817Date d;
+
+        if (s->regs[RTC_CTRL] & RTC_CTRL_READSEL) {
+            d = s->rtc_latch;
+        } else {
+            rk817_rtc_now(s, &d);
+        }
+        return rk817_rtc_field(&d, reg);
+    }
+    if ((reg >= FG_Q_PRESS_H3 && reg <= FG_SYS_VOL_H + 1) ||
+        reg == CHRG_STS || reg == SYS_STS) {
+        rk817_fg_refresh(s);
+    }
+    return s->regs[reg];
+}
+
+static void rk817_sleep_pin_action(RK817State *s)
+{
+    unsigned func = (s->regs[SYS_CFG3] >> SYS_CFG3_SLPPIN_SHIFT) & 3;
+
+    switch (func) {
+    case 2:     /* power down */
+        qemu_log_mask(CPU_LOG_RESET, "rk817: SLEEP pin power down\n");
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        break;
+    case 3:     /* reset */
+        qemu_log_mask(CPU_LOG_RESET, "rk817: SLEEP pin reset\n");
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+        break;
+    default:    /* none / sleep: regulators switch to sleep config */
+        break;
+    }
+}
+
+static void rk817_reg_write(RK817State *s, uint8_t reg, uint8_t val)
+{
+    uint8_t old = s->regs[reg];
+
+    if (reg <= RTC_WEEKS) {
+        rk817_rtc_rebase(s);
+        rk817_rtc_set_field(&s->rtc_base, reg, val);
+        return;
+    }
+    switch (reg) {
+    case RTC_CTRL:
+        if ((val & RTC_CTRL_STOP) && !(old & RTC_CTRL_STOP)) {
+            rk817_rtc_now(s, &s->rtc_base);
+            s->rtc_stopped = true;
+        } else if (!(val & RTC_CTRL_STOP) && (old & RTC_CTRL_STOP)) {
+            s->rtc_base_ns = qemu_clock_get_ns(rtc_clock);
+            s->rtc_stopped = false;
+        }
+        if ((val & RTC_CTRL_GET_TIME) && !(old & RTC_CTRL_GET_TIME)) {
+            rk817_rtc_now(s, &s->rtc_latch);
+        }
+        s->regs[reg] = val;
+        return;
+    case RTC_STATUS:
+        s->regs[reg] &= ~(val & 0xfe);
+        return;
+    case RTC_INT:
+        s->regs[reg] = val;
+        if (val & RTC_INT_ALARM_EN) {
+            timer_mod(s->rtc_timer, qemu_clock_get_ms(rtc_clock) + 500);
+        } else {
+            timer_del(s->rtc_timer);
+        }
+        return;
+    case FG_Q_INIT_L0:
+        s->regs[reg] = val;
+        s->q_press = ((uint32_t)s->regs[FG_Q_INIT_H3] << 24) |
+                     ((uint32_t)s->regs[FG_Q_INIT_H3 + 1] << 16) |
+                     ((uint32_t)s->regs[FG_Q_INIT_H3 + 2] << 8) | val;
+        s->q_press &= 0x7fffffff;
+        s->q_valid = true;
+        s->q_last_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        return;
+    case POWER_EN_REG0 ... POWER_EN_REG3: {
+        uint8_t mask = val >> 4;
+
+        s->regs[reg] = (old & ~mask & 0x0f) | (val & mask & 0x0f);
+        return;
+    }
+    case SYS_CFG3:
+        s->regs[reg] = val;
+        if (val & SYS_CFG3_DEV_OFF) {
+            qemu_log_mask(CPU_LOG_RESET, "rk817: DEV_OFF, powering off\n");
+            qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        }
+        return;
+    case INT_STS0:
+    case INT_STS1:
+    case INT_STS2:
+        s->regs[reg] &= ~val;
+        rk817_update_irq(s);
+        return;
+    case INT_MSK0:
+    case INT_MSK1:
+    case INT_MSK2:
+    case GPIO_INT_CFG:
+        s->regs[reg] = val;
+        rk817_update_irq(s);
+        return;
+    case ID_MSB:
+    case ID_LSB:
+    case CHRG_STS:
+    case ON_SOURCE:
+    case OFF_SOURCE:
+        return;
+    case FG_Q_PRESS_H3 ... FG_Q_PRESS_L0:
+    case FG_BAT_VOL_H ... FG_SYS_VOL_H + 1:
+        return;
+    case SYS_STS:
+        s->regs[reg] = (val & ~SYS_STS_PLUG_IN) | (old & SYS_STS_PLUG_IN);
+        return;
+    }
+    s->regs[reg] = val;
+}
+
+static int rk817_event(I2CSlave *i2c, enum i2c_event event)
+{
+    RK817State *s = RK817(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+    }
+    return 0;
+}
+
+static uint8_t rk817_recv(I2CSlave *i2c)
+{
+    RK817State *s = RK817(i2c);
+
+    return rk817_reg_read(s, s->ptr++);
+}
+
+static int rk817_send(I2CSlave *i2c, uint8_t data)
+{
+    RK817State *s = RK817(i2c);
+
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+        return 0;
+    }
+    rk817_reg_write(s, s->ptr++, data);
+    return 0;
+}
+
+void rk817_set_pwrkey(RK817State *s, bool pressed)
+{
+    if (pressed == s->pwrkey) {
+        return;
+    }
+    s->pwrkey = pressed;
+    s->regs[INT_STS0] |= pressed ? IRQ0_PWRON_FALL : IRQ0_PWRON_RISE;
+    rk817_update_irq(s);
+}
+
+void rk817_set_dc_in(RK817State *s, bool present)
+{
+    if (present == s->dc_in) {
+        return;
+    }
+    s->dc_in = present;
+    s->regs[INT_STS1] |= present ? IRQ1_PLUG_IN : IRQ1_PLUG_OUT;
+    rk817_fg_refresh(s);
+    rk817_update_irq(s);
+}
+
+static void rk817_set_sleep_pin(void *opaque, int n, int level)
+{
+    RK817State *s = opaque;
+    bool pol_high = s->regs[SYS_CFG3] & SYS_CFG3_SLPPOL_H;
+    bool was_active = s->sleep_pin == pol_high;
+
+    s->sleep_pin = level;
+    if (!was_active && (s->sleep_pin == pol_high)) {
+        rk817_sleep_pin_action(s);
+    }
+}
+
+static void rk817_reset_hold(Object *obj)
+{
+    RK817State *s = RK817(obj);
+
+    rk817_regs_reset(s, !s->powered);
+    s->powered = true;
+}
+
+static void rk817_reset_exit(Object *obj)
+{
+    RK817State *s = RK817(obj);
+
+    rk817_update_irq(s);
+}
+
+static void rk817_realize(DeviceState *dev, Error **errp)
+{
+    RK817State *s = RK817(dev);
+
+    s->rtc_timer = timer_new_ms(rtc_clock, rk817_rtc_tick, s);
+    qdev_init_gpio_out_named(dev, &s->irq, "irq", 1);
+    qdev_init_gpio_in_named(dev, rk817_set_sleep_pin, "sleep", 1);
+}
+
+static Property rk817_props[] = {
+    DEFINE_PROP_UINT32("battery-mv", RK817State, bat_mv, 3900),
+    DEFINE_PROP_INT32("battery-ma", RK817State, bat_ma, 0),
+    DEFINE_PROP_UINT32("usb-mv", RK817State, usb_mv, 5000),
+    DEFINE_PROP_BOOL("dc-in", RK817State, dc_in, false),
+    DEFINE_PROP_BOOL("battery-present", RK817State, battery_present, true),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static const VMStateDescription vmstate_rk817_date = {
+    .name = "rk817-date",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_INT32(sec, RK817Date),
+        VMSTATE_INT32(min, RK817Date),
+        VMSTATE_INT32(hour, RK817Date),
+        VMSTATE_INT32(mday, RK817Date),
+        VMSTATE_INT32(mon, RK817Date),
+        VMSTATE_INT32(year, RK817Date),
+        VMSTATE_INT32(wday, RK817Date),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const VMStateDescription vmstate_rk817 = {
+    .name = TYPE_RK817,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, RK817State),
+        VMSTATE_UINT8_ARRAY(regs, RK817State, 256),
+        VMSTATE_UINT8(ptr, RK817State),
+        VMSTATE_BOOL(ptr_set, RK817State),
+        VMSTATE_BOOL(sleep_pin, RK817State),
+        VMSTATE_BOOL(pwrkey, RK817State),
+        VMSTATE_STRUCT(rtc_base, RK817State, 1, vmstate_rk817_date, RK817Date),
+        VMSTATE_INT64(rtc_base_ns, RK817State),
+        VMSTATE_BOOL(rtc_stopped, RK817State),
+        VMSTATE_STRUCT(rtc_latch, RK817State, 1, vmstate_rk817_date,
+                       RK817Date),
+        VMSTATE_INT64(q_press, RK817State),
+        VMSTATE_BOOL(q_valid, RK817State),
+        VMSTATE_BOOL(powered, RK817State),
+        VMSTATE_INT64(q_last_ns, RK817State),
+        VMSTATE_BOOL(dc_in, RK817State),
+        VMSTATE_TIMER_PTR(rtc_timer, RK817State),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk817_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *isc = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = rk817_realize;
+    dc->vmsd = &vmstate_rk817;
+    device_class_set_props(dc, rk817_props);
+    rc->phases.hold = rk817_reset_hold;
+    rc->phases.exit = rk817_reset_exit;
+    isc->event = rk817_event;
+    isc->recv = rk817_recv;
+    isc->send = rk817_send;
+}
+
+static const TypeInfo rk817_info = {
+    .name = TYPE_RK817,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(RK817State),
+    .class_init = rk817_class_init,
+};
+
+static void rk817_register_types(void)
+{
+    type_register_static(&rk817_info);
+}
+
+type_init(rk817_register_types)
diff --git a/hw/misc/rockchip_grf.c b/hw/misc/rockchip_grf.c
new file mode 100644
index 00000000..4ebabb61
--- /dev/null
+++ b/hw/misc/rockchip_grf.c
@@ -0,0 +1,181 @@
+/*
+ * Rockchip General Register File (GRF / PMUGRF / syscon) model
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/rockchip_grf.h"
+#include "migration/vmstate.h"
+
+static uint64_t rk_grf_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RockchipGRFState *s = opaque;
+
+    return s->regs[offset >> 2];
+}
+
+static void rk_grf_pvtm_update(RockchipGRFState *s)
+{
+    uint32_t con = s->regs[s->pvtm_con >> 2];
+    uint32_t cal = s->regs[(s->pvtm_con + 4) >> 2];
+
+    if ((con & 3) == 3) {
+        /* measurement over CAL cycles of the 24 MHz clock */
+        s->regs[s->pvtm_sta >> 2] |= 1;
+        s->regs[(s->pvtm_sta + 4) >> 2] =
+            (uint64_t)cal * s->pvtm_rate / 24000;
+    } else {
+        s->regs[s->pvtm_sta >> 2] &= ~1u;
+    }
+}
+
+void rockchip_grf_add_pvtm(RockchipGRFState *s, hwaddr con, hwaddr sta,
+                           uint32_t counts_per_ms)
+{
+    s->has_pvtm = true;
+    s->pvtm_con = con;
+    s->pvtm_sta = sta;
+    s->pvtm_rate = counts_per_ms;
+    rockchip_grf_set_reg(s, con + 4, 0, RK_GRF_F_PLAIN);
+    rockchip_grf_set_reg(s, sta, 0, RK_GRF_F_RO);
+    rockchip_grf_set_reg(s, sta + 4, 0, RK_GRF_F_RO);
+}
+
+static void rk_grf_write(void *opaque, hwaddr offset, uint64_t value,
+                         unsigned size)
+{
+    RockchipGRFState *s = opaque;
+    unsigned idx = offset >> 2;
+    uint32_t mask;
+
+    if (s->flags[idx] & RK_GRF_F_RO) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: write to read-only register 0x%" HWADDR_PRIx "\n",
+                      s->name, offset);
+        return;
+    }
+    if (s->flags[idx] & RK_GRF_F_PLAIN) {
+        s->regs[idx] = value;
+        if (s->has_pvtm && offset == s->pvtm_con + 4) {
+            rk_grf_pvtm_update(s);
+        }
+        return;
+    }
+    mask = (value >> 16) & 0xffff;
+    s->regs[idx] = (s->regs[idx] & ~mask) | (value & mask);
+    if (s->has_pvtm && offset == s->pvtm_con) {
+        rk_grf_pvtm_update(s);
+    }
+}
+
+static const MemoryRegionOps rk_grf_ops = {
+    .read = rk_grf_read,
+    .write = rk_grf_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+void rockchip_grf_set_reg(RockchipGRFState *s, hwaddr offset,
+                          uint32_t reset_value, unsigned flags)
+{
+    unsigned idx = offset >> 2;
+
+    assert(offset < s->size);
+    s->reset_val[idx] = reset_value;
+    s->flags[idx] = flags;
+    s->regs[idx] = reset_value;
+}
+
+void rockchip_grf_set_range_flags(RockchipGRFState *s, hwaddr start,
+                                  hwaddr end, unsigned flags)
+{
+    for (hwaddr o = start; o < end && o < s->size; o += 4) {
+        s->flags[o >> 2] = flags;
+    }
+}
+
+uint32_t rockchip_grf_read_reg(RockchipGRFState *s, hwaddr offset)
+{
+    return s->regs[offset >> 2];
+}
+
+static void rk_grf_reset_hold(Object *obj)
+{
+    RockchipGRFState *s = ROCKCHIP_GRF(obj);
+
+    for (unsigned i = 0; i < s->size / 4; i++) {
+        if ((s->flags[i] & RK_GRF_F_KEEP) && s->powered_on) {
+            continue;
+        }
+        s->regs[i] = s->reset_val[i];
+    }
+    s->powered_on = true;
+}
+
+static void rk_grf_realize(DeviceState *dev, Error **errp)
+{
+    RockchipGRFState *s = ROCKCHIP_GRF(dev);
+
+    if (!s->size || (s->size & 3)) {
+        error_setg(errp, "rockchip-grf: invalid size 0x%x", s->size);
+        return;
+    }
+    s->nregs = s->size / 4;
+    s->regs = g_new0(uint32_t, s->nregs);
+    s->reset_val = g_new0(uint32_t, s->size / 4);
+    s->flags = g_new0(uint8_t, s->size / 4);
+    memory_region_init_io(&s->iomem, OBJECT(s), &rk_grf_ops, s,
+                          s->name ? s->name : TYPE_ROCKCHIP_GRF, s->size);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+}
+
+static Property rk_grf_props[] = {
+    DEFINE_PROP_UINT32("size", RockchipGRFState, size, 0x1000),
+    DEFINE_PROP_STRING("name", RockchipGRFState, name),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static const VMStateDescription vmstate_rk_grf = {
+    .name = TYPE_ROCKCHIP_GRF,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_BOOL(powered_on, RockchipGRFState),
+        VMSTATE_VARRAY_UINT32(regs, RockchipGRFState, nregs, 0,
+                              vmstate_info_uint32, uint32_t),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_grf_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = rk_grf_realize;
+    dc->vmsd = &vmstate_rk_grf;
+    device_class_set_props(dc, rk_grf_props);
+    rc->phases.hold = rk_grf_reset_hold;
+}
+
+static const TypeInfo rk_grf_info = {
+    .name = TYPE_ROCKCHIP_GRF,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RockchipGRFState),
+    .class_init = rk_grf_class_init,
+};
+
+static void rk_grf_register_types(void)
+{
+    type_register_static(&rk_grf_info);
+}
+
+type_init(rk_grf_register_types)
diff --git a/hw/misc/rockchip_iommu.c b/hw/misc/rockchip_iommu.c
new file mode 100644
index 00000000..db3ad309
--- /dev/null
+++ b/hw/misc/rockchip_iommu.c
@@ -0,0 +1,304 @@
+/*
+ * Rockchip IOMMU (v1, "rockchip,iommu") model
+ *
+ * Two-level page table, 4 KiB pages:
+ *   iova[31:22] index into the directory table at DTE_ADDR
+ *   DTE: [31:12] page table address, [0] valid
+ *   iova[21:12] index into the page table
+ *   PTE: [31:12] page address, [2] writable, [1] readable, [0] valid
+ *
+ *   0x00 DTE_ADDR  0x04 STATUS  0x08 COMMAND  0x0c PAGE_FAULT_ADDR
+ *   0x10 ZAP_ONE_LINE  0x14 INT_RAWSTAT  0x18 INT_CLEAR  0x1c INT_MASK
+ *   0x20 INT_STATUS    0x24 AUTO_GATING
+ *
+ * There is no IOTLB, so zap commands are no-ops.  The model does not sit
+ * in the memory path; bus masters that are behind it (the VOP) call
+ * rockchip_iommu_translate().
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/rockchip_iommu.h"
+#include "migration/vmstate.h"
+#include "exec/address-spaces.h"
+#include "exec/memory.h"
+
+#define RK_MMU_DTE_ADDR         0x00
+#define RK_MMU_STATUS           0x04
+#define RK_MMU_COMMAND          0x08
+#define RK_MMU_PAGE_FAULT_ADDR  0x0c
+#define RK_MMU_ZAP_ONE_LINE     0x10
+#define RK_MMU_INT_RAWSTAT      0x14
+#define RK_MMU_INT_CLEAR        0x18
+#define RK_MMU_INT_MASK         0x1c
+#define RK_MMU_INT_STATUS       0x20
+#define RK_MMU_AUTO_GATING      0x24
+
+#define STATUS_PAGING_ENABLED       (1u << 0)
+#define STATUS_PAGE_FAULT_ACTIVE    (1u << 1)
+#define STATUS_STALL_ACTIVE         (1u << 2)
+#define STATUS_IDLE                 (1u << 3)
+#define STATUS_REPLAY_BUFFER_EMPTY  (1u << 4)
+#define STATUS_PAGE_FAULT_IS_WRITE  (1u << 5)
+#define STATUS_STALL_NOT_ACTIVE     (1u << 31)
+
+#define CMD_ENABLE_PAGING       0
+#define CMD_DISABLE_PAGING      1
+#define CMD_ENABLE_STALL        2
+#define CMD_DISABLE_STALL       3
+#define CMD_ZAP_CACHE           4
+#define CMD_PAGE_FAULT_DONE     5
+#define CMD_FORCE_RESET         6
+
+#define IRQ_PAGE_FAULT          0x01
+#define IRQ_BUS_ERROR           0x02
+
+#define DTE_ADDR_MASK           0xfffff000
+#define ENTRY_VALID             (1u << 0)
+#define PTE_READABLE            (1u << 1)
+#define PTE_WRITABLE            (1u << 2)
+
+static void rk_iommu_update_irq(RockchipIOMMUState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_rawstat & s->int_mask));
+}
+
+static void rk_iommu_regs_reset(RockchipIOMMUState *s)
+{
+    s->dte_addr = 0;
+    s->paging = false;
+    s->stall = false;
+    s->fault = false;
+    s->fault_addr = 0;
+    s->int_rawstat = 0;
+    s->int_mask = 0;
+    s->auto_gating = 0;
+}
+
+bool rockchip_iommu_translate(RockchipIOMMUState *s, uint32_t iova,
+                              bool is_write, hwaddr *pa)
+{
+    uint32_t dte, pte;
+    MemTxResult r;
+
+    if (!s->paging) {
+        *pa = iova;
+        return true;
+    }
+
+    dte = address_space_ldl_le(&s->dma_as,
+                               s->dte_addr + ((iova >> 22) & 0x3ff) * 4,
+                               MEMTXATTRS_UNSPECIFIED, &r);
+    if (r != MEMTX_OK) {
+        goto bus_error;
+    }
+    if (!(dte & ENTRY_VALID)) {
+        goto fault;
+    }
+    pte = address_space_ldl_le(&s->dma_as,
+                               (dte & DTE_ADDR_MASK) +
+                               ((iova >> 12) & 0x3ff) * 4,
+                               MEMTXATTRS_UNSPECIFIED, &r);
+    if (r != MEMTX_OK) {
+        goto bus_error;
+    }
+    if (!(pte & ENTRY_VALID) ||
+        !(pte & (is_write ? PTE_WRITABLE : PTE_READABLE))) {
+        goto fault;
+    }
+    *pa = (pte & DTE_ADDR_MASK) | (iova & 0xfff);
+    return true;
+
+fault:
+    if (!s->fault) {
+        s->fault = true;
+        s->fault_addr = iova;
+        s->int_rawstat |= IRQ_PAGE_FAULT;
+        rk_iommu_update_irq(s);
+    }
+    return false;
+bus_error:
+    s->int_rawstat |= IRQ_BUS_ERROR;
+    rk_iommu_update_irq(s);
+    return false;
+}
+
+static uint64_t rk_iommu_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RockchipIOMMUState *s = opaque;
+    uint32_t val;
+
+    switch (offset) {
+    case RK_MMU_DTE_ADDR:
+        return s->dte_addr;
+    case RK_MMU_STATUS:
+        val = STATUS_IDLE | STATUS_REPLAY_BUFFER_EMPTY;
+        if (s->paging) {
+            val |= STATUS_PAGING_ENABLED;
+        }
+        if (s->fault) {
+            val |= STATUS_PAGE_FAULT_ACTIVE;
+        }
+        /* stall only takes effect while paging is enabled */
+        if (s->stall && s->paging) {
+            val |= STATUS_STALL_ACTIVE;
+        } else {
+            val |= STATUS_STALL_NOT_ACTIVE;
+        }
+        return val;
+    case RK_MMU_PAGE_FAULT_ADDR:
+        return s->fault_addr;
+    case RK_MMU_INT_RAWSTAT:
+        return s->int_rawstat;
+    case RK_MMU_INT_MASK:
+        return s->int_mask;
+    case RK_MMU_INT_STATUS:
+        return s->int_rawstat & s->int_mask;
+    case RK_MMU_AUTO_GATING:
+        return s->auto_gating;
+    }
+    return 0;
+}
+
+static void rk_iommu_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    RockchipIOMMUState *s = opaque;
+
+    switch (offset) {
+    case RK_MMU_DTE_ADDR:
+        s->dte_addr = value & DTE_ADDR_MASK;
+        break;
+    case RK_MMU_COMMAND:
+        switch (value & 7) {
+        case CMD_ENABLE_PAGING:
+            s->paging = true;
+            break;
+        case CMD_DISABLE_PAGING:
+            s->paging = false;
+            break;
+        case CMD_ENABLE_STALL:
+            s->stall = true;
+            break;
+        case CMD_DISABLE_STALL:
+            s->stall = false;
+            break;
+        case CMD_ZAP_CACHE:
+            break;
+        case CMD_PAGE_FAULT_DONE:
+            s->fault = false;
+            break;
+        case CMD_FORCE_RESET:
+            rk_iommu_regs_reset(s);
+            break;
+        }
+        break;
+    case RK_MMU_ZAP_ONE_LINE:
+        break;
+    case RK_MMU_INT_CLEAR:
+        s->int_rawstat &= ~value;
+        break;
+    case RK_MMU_INT_MASK:
+        s->int_mask = value & (IRQ_PAGE_FAULT | IRQ_BUS_ERROR);
+        break;
+    case RK_MMU_AUTO_GATING:
+        s->auto_gating = value;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "rockchip-iommu: write to RO/bad "
+                      "offset 0x%" HWADDR_PRIx "\n", offset);
+    }
+    rk_iommu_update_irq(s);
+}
+
+static const MemoryRegionOps rk_iommu_ops = {
+    .read = rk_iommu_read,
+    .write = rk_iommu_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void rk_iommu_reset_hold(Object *obj)
+{
+    rk_iommu_regs_reset(ROCKCHIP_IOMMU(obj));
+}
+
+static void rk_iommu_realize(DeviceState *dev, Error **errp)
+{
+    RockchipIOMMUState *s = ROCKCHIP_IOMMU(dev);
+
+    if (s->size < 0x28 || s->size > 0x1000) {
+        error_setg(errp, "rockchip-iommu: invalid size 0x%x", s->size);
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(s), &rk_iommu_ops, s,
+                          TYPE_ROCKCHIP_IOMMU, s->size);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+
+    address_space_init(&s->dma_as, s->dma_mr ? s->dma_mr : get_system_memory(),
+                       "rockchip-iommu-dma");
+}
+
+static void rk_iommu_init(Object *obj)
+{
+    RockchipIOMMUState *s = ROCKCHIP_IOMMU(obj);
+
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static Property rk_iommu_props[] = {
+    DEFINE_PROP_UINT32("size", RockchipIOMMUState, size, 0x100),
+    DEFINE_PROP_LINK("dma-memory", RockchipIOMMUState, dma_mr,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static const VMStateDescription vmstate_rk_iommu = {
+    .name = TYPE_ROCKCHIP_IOMMU,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32(dte_addr, RockchipIOMMUState),
+        VMSTATE_BOOL(paging, RockchipIOMMUState),
+        VMSTATE_BOOL(stall, RockchipIOMMUState),
+        VMSTATE_BOOL(fault, RockchipIOMMUState),
+        VMSTATE_UINT32(fault_addr, RockchipIOMMUState),
+        VMSTATE_UINT32(int_rawstat, RockchipIOMMUState),
+        VMSTATE_UINT32(int_mask, RockchipIOMMUState),
+        VMSTATE_UINT32(auto_gating, RockchipIOMMUState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_iommu_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = rk_iommu_realize;
+    dc->vmsd = &vmstate_rk_iommu;
+    device_class_set_props(dc, rk_iommu_props);
+    rc->phases.hold = rk_iommu_reset_hold;
+}
+
+static const TypeInfo rk_iommu_info = {
+    .name = TYPE_ROCKCHIP_IOMMU,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RockchipIOMMUState),
+    .instance_init = rk_iommu_init,
+    .class_init = rk_iommu_class_init,
+};
+
+static void rk_iommu_register_types(void)
+{
+    type_register_static(&rk_iommu_info);
+}
+
+type_init(rk_iommu_register_types)
diff --git a/hw/misc/rockchip_pwm.c b/hw/misc/rockchip_pwm.c
new file mode 100644
index 00000000..48159b6a
--- /dev/null
+++ b/hw/misc/rockchip_pwm.c
@@ -0,0 +1,192 @@
+/*
+ * Rockchip PWM v2 (rk3328-pwm / px30-pwm) model
+ *
+ * One instance covers a block of four channels (PX30: pwm0-3 at
+ * 0xff200000, pwm4-7 at 0xff208000).  Per channel (stride 0x10):
+ *   0x0 CNT          counter (read-only)
+ *   0x4 PERIOD_HPR   period / high period (capture)
+ *   0x8 DUTY_LPR     duty / low period (capture)
+ *   0xc CTRL         [0] enable, [2:1] mode, [3] duty polarity,
+ *                    [4] inactive polarity, [5] output mode, [6] conf lock
+ * Shared: 0x40 INTSTS, 0x44 INT_EN.
+ *
+ * The output waveform is not generated; the configured level is
+ * available to the board (backlight).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/misc/rockchip_pwm.h"
+#include "migration/vmstate.h"
+
+#define PWM_CNT         0x0
+#define PWM_PERIOD      0x4
+#define PWM_DUTY        0x8
+#define PWM_CTRL        0xc
+#define PWM_INTSTS      0x40
+#define PWM_INT_EN      0x44
+
+#define CTRL_ENABLE     (1u << 0)
+#define CTRL_MODE_MASK  (3u << 1)
+#define CTRL_MODE_CONT  (1u << 1)
+#define CTRL_DUTY_POS   (1u << 3)
+#define CTRL_LOCK       (1u << 6)
+
+unsigned rockchip_pwm_get_level(RockchipPWMState *s, int ch)
+{
+    RockchipPWMChannel *c = &s->ch[ch];
+    unsigned level;
+
+    if (!(c->ctrl & CTRL_ENABLE) || !c->period) {
+        /* inactive polarity bit set means the output idles high */
+        return (c->ctrl & (1u << 4)) ? 1000 : 0;
+    }
+    level = MIN((uint64_t)c->duty * 1000 / c->period, 1000);
+    return (c->ctrl & CTRL_DUTY_POS) ? level : 1000 - level;
+}
+
+static uint64_t rk_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RockchipPWMState *s = opaque;
+
+    if (offset < 0x40) {
+        RockchipPWMChannel *c = &s->ch[offset >> 4];
+
+        switch (offset & 0xf) {
+        case PWM_CNT:
+            return 0;
+        case PWM_PERIOD:
+            return c->period;
+        case PWM_DUTY:
+            return c->duty;
+        case PWM_CTRL:
+            return c->ctrl;
+        }
+    }
+    switch (offset) {
+    case PWM_INTSTS:
+        return s->intsts;
+    case PWM_INT_EN:
+        return s->int_en;
+    }
+    return 0;
+}
+
+static void rk_pwm_write(void *opaque, hwaddr offset, uint64_t value,
+                         unsigned size)
+{
+    RockchipPWMState *s = opaque;
+
+    if (offset < 0x40) {
+        RockchipPWMChannel *c = &s->ch[offset >> 4];
+
+        switch (offset & 0xf) {
+        case PWM_PERIOD:
+            c->period = value;
+            break;
+        case PWM_DUTY:
+            c->duty = value;
+            break;
+        case PWM_CTRL:
+            c->ctrl = value;
+            break;
+        default:
+            qemu_log_mask(LOG_GUEST_ERROR, "rockchip-pwm: write to RO reg 0x%"
+                          HWADDR_PRIx "\n", offset);
+        }
+        return;
+    }
+    switch (offset) {
+    case PWM_INTSTS:
+        s->intsts &= ~value;
+        break;
+    case PWM_INT_EN:
+        s->int_en = value;
+        break;
+    }
+    qemu_set_irq(s->irq, !!(s->intsts & s->int_en));
+}
+
+static const MemoryRegionOps rk_pwm_ops = {
+    .read = rk_pwm_read,
+    .write = rk_pwm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void rk_pwm_reset_hold(Object *obj)
+{
+    RockchipPWMState *s = ROCKCHIP_PWM(obj);
+
+    for (int i = 0; i < ROCKCHIP_PWM_CHANNELS; i++) {
+        s->ch[i].period = 0;
+        s->ch[i].duty = 0;
+        s->ch[i].ctrl = 0;
+    }
+    s->intsts = 0;
+    s->int_en = 0;
+}
+
+static void rk_pwm_init(Object *obj)
+{
+    RockchipPWMState *s = ROCKCHIP_PWM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &rk_pwm_ops, s, TYPE_ROCKCHIP_PWM,
+                          0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static const VMStateDescription vmstate_rk_pwm_ch = {
+    .name = "rockchip-pwm-channel",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_UINT32(period, RockchipPWMChannel),
+        VMSTATE_UINT32(duty, RockchipPWMChannel),
+        VMSTATE_UINT32(ctrl, RockchipPWMChannel),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const VMStateDescription vmstate_rk_pwm = {
+    .name = TYPE_ROCKCHIP_PWM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_STRUCT_ARRAY(ch, RockchipPWMState, ROCKCHIP_PWM_CHANNELS, 1,
+                             vmstate_rk_pwm_ch, RockchipPWMChannel),
+        VMSTATE_UINT32(intsts, RockchipPWMState),
+        VMSTATE_UINT32(int_en, RockchipPWMState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_pwm_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &vmstate_rk_pwm;
+    rc->phases.hold = rk_pwm_reset_hold;
+}
+
+static const TypeInfo rk_pwm_info = {
+    .name = TYPE_ROCKCHIP_PWM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RockchipPWMState),
+    .instance_init = rk_pwm_init,
+    .class_init = rk_pwm_class_init,
+};
+
+static void rk_pwm_register_types(void)
+{
+    type_register_static(&rk_pwm_info);
+}
+
+type_init(rk_pwm_register_types)
diff --git a/hw/misc/rockchip_tsadc.c b/hw/misc/rockchip_tsadc.c
new file mode 100644
index 00000000..a026e172
--- /dev/null
+++ b/hw/misc/rockchip_tsadc.c
@@ -0,0 +1,228 @@
+/*
+ * Rockchip TSADC (px30-tsadc) model
+ *
+ * Two sensors (0: CPU, 1: GPU).  The conversion result follows the
+ * rk3328/px30 code table (12-bit, code increases with temperature) of
+ * drivers/thermal/rockchip_thermal.c.  Sensor temperatures are QOM
+ * properties ("temperature0", "temperature1", milli-degree Celsius) and
+ * can be changed at run time with qom-set to exercise thermal code.
+ *
+ * In auto mode the high temperature alarm interrupt and the thermal
+ * shutdown (TSHUT to CRU = global reset) are evaluated whenever the
+ * configuration or a temperature changes.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/misc/rockchip_tsadc.h"
+#include "migration/vmstate.h"
+#include "sysemu/runstate.h"
+
+#define TSADC_USER_CON          0x00
+#define TSADC_AUTO_CON          0x04
+#define TSADC_INT_EN            0x08
+#define TSADC_INT_PD            0x0c
+#define TSADC_DATA(ch)          (0x20 + (ch) * 4)
+#define TSADC_COMP_INT(ch)      (0x30 + (ch) * 4)
+#define TSADC_COMP_SHUT(ch)     (0x40 + (ch) * 4)
+
+#define AUTO_EN                 (1u << 0)
+#define AUTO_SRC_EN(ch)         (1u << (4 + (ch)))
+#define INT_SRC_EN(ch)          (1u << (ch))
+#define SHUT_2CRU_SRC_EN(ch)    (1u << (8 + (ch)))
+
+static const struct {
+    uint32_t code;
+    int32_t temp;
+} rk_tsadc_table[] = {
+    { 296, -40000 }, { 304, -35000 }, { 313, -30000 }, { 331, -20000 },
+    { 340, -15000 }, { 349, -10000 }, { 359, -5000 }, { 368, 0 },
+    { 378, 5000 }, { 388, 10000 }, { 398, 15000 }, { 408, 20000 },
+    { 418, 25000 }, { 429, 30000 }, { 440, 35000 }, { 451, 40000 },
+    { 462, 45000 }, { 473, 50000 }, { 485, 55000 }, { 496, 60000 },
+    { 508, 65000 }, { 521, 70000 }, { 533, 75000 }, { 546, 80000 },
+    { 559, 85000 }, { 572, 90000 }, { 586, 95000 }, { 600, 100000 },
+    { 614, 105000 }, { 629, 110000 }, { 644, 115000 }, { 659, 120000 },
+    { 675, 125000 },
+};
+
+static uint32_t rk_tsadc_temp_to_code(int32_t temp)
+{
+    int n = ARRAY_SIZE(rk_tsadc_table);
+
+    if (temp <= rk_tsadc_table[0].temp) {
+        return rk_tsadc_table[0].code;
+    }
+    for (int i = 1; i < n; i++) {
+        if (temp <= rk_tsadc_table[i].temp) {
+            int32_t t0 = rk_tsadc_table[i - 1].temp;
+            int32_t t1 = rk_tsadc_table[i].temp;
+            uint32_t c0 = rk_tsadc_table[i - 1].code;
+            uint32_t c1 = rk_tsadc_table[i].code;
+
+            return c0 + (uint32_t)((int64_t)(temp - t0) * (c1 - c0) /
+                                   (t1 - t0));
+        }
+    }
+    return rk_tsadc_table[n - 1].code;
+}
+
+static void rk_tsadc_update(RockchipTSADCState *s)
+{
+    uint32_t auto_con = s->regs[TSADC_AUTO_CON >> 2];
+    uint32_t int_en = s->regs[TSADC_INT_EN >> 2];
+    bool shut = false;
+
+    if (auto_con & AUTO_EN) {
+        for (int ch = 0; ch < ROCKCHIP_TSADC_CHANNELS; ch++) {
+            uint32_t code = rk_tsadc_temp_to_code(s->temp[ch]);
+
+            if (!(auto_con & AUTO_SRC_EN(ch))) {
+                continue;
+            }
+            if ((int_en & INT_SRC_EN(ch)) &&
+                s->regs[TSADC_COMP_INT(ch) >> 2] &&
+                code >= s->regs[TSADC_COMP_INT(ch) >> 2]) {
+                s->regs[TSADC_INT_PD >> 2] |= INT_SRC_EN(ch);
+            }
+            if ((int_en & SHUT_2CRU_SRC_EN(ch)) &&
+                s->regs[TSADC_COMP_SHUT(ch) >> 2] &&
+                code >= s->regs[TSADC_COMP_SHUT(ch) >> 2]) {
+                shut = true;
+            }
+        }
+    }
+    qemu_set_irq(s->irq, !!(s->regs[TSADC_INT_PD >> 2] & int_en & 0xf));
+    if (shut) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "rockchip-tsadc: over-temperature shutdown\n");
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
+
+static uint64_t rk_tsadc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RockchipTSADCState *s = opaque;
+
+    if (offset == TSADC_DATA(0) || offset == TSADC_DATA(1)) {
+        return rk_tsadc_temp_to_code(s->temp[(offset - TSADC_DATA(0)) / 4]);
+    }
+    return s->regs[offset >> 2];
+}
+
+static void rk_tsadc_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    RockchipTSADCState *s = opaque;
+
+    switch (offset) {
+    case TSADC_INT_PD:
+        /* write 1 to clear the alarm status bits */
+        s->regs[offset >> 2] &= ~(value & 0xff);
+        break;
+    case TSADC_DATA(0):
+    case TSADC_DATA(1):
+        return;
+    default:
+        s->regs[offset >> 2] = value;
+    }
+    rk_tsadc_update(s);
+}
+
+static const MemoryRegionOps rk_tsadc_ops = {
+    .read = rk_tsadc_read,
+    .write = rk_tsadc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void rk_tsadc_get_temp(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    visit_type_int32(v, name, opaque, errp);
+}
+
+static void rk_tsadc_set_temp(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    RockchipTSADCState *s = ROCKCHIP_TSADC(obj);
+    int32_t *p = opaque;
+    int32_t val;
+
+    if (!visit_type_int32(v, name, &val, errp)) {
+        return;
+    }
+    *p = val;
+    if (DEVICE(obj)->realized) {
+        rk_tsadc_update(s);
+    }
+}
+
+static void rk_tsadc_reset_hold(Object *obj)
+{
+    RockchipTSADCState *s = ROCKCHIP_TSADC(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void rk_tsadc_init(Object *obj)
+{
+    RockchipTSADCState *s = ROCKCHIP_TSADC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &rk_tsadc_ops, s,
+                          TYPE_ROCKCHIP_TSADC, 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+
+    for (int i = 0; i < ROCKCHIP_TSADC_CHANNELS; i++) {
+        g_autofree char *name = g_strdup_printf("temperature%d", i);
+
+        s->temp[i] = 40000;
+        object_property_add(obj, name, "int32",
+                            rk_tsadc_get_temp,
+                            rk_tsadc_set_temp, NULL, &s->temp[i]);
+    }
+}
+
+static const VMStateDescription vmstate_rk_tsadc = {
+    .name = TYPE_ROCKCHIP_TSADC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (VMStateField[]) {
+        VMSTATE_INT32_ARRAY(temp, RockchipTSADCState,
+                            ROCKCHIP_TSADC_CHANNELS),
+        VMSTATE_UINT32_ARRAY(regs, RockchipTSADCState, ROCKCHIP_TSADC_NREGS),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void rk_tsadc_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->vmsd = &vmstate_rk_tsadc;
+    rc->phases.hold = rk_tsadc_reset_hold;
+}
+
+static const TypeInfo rk_tsadc_info = {
+    .name = TYPE_ROCKCHIP_TSADC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RockchipTSADCState),
+    .instance_init = rk_tsadc_init,
+    .class_init = rk_tsadc_class_init,
+};
+
+static void rk_tsadc_register_types(void)
+{
+    type_register_static(&rk_tsadc_info);
+}
+
+type_init(rk_tsadc_register_types)
